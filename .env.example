# SupeRR Intelligence Lab - Environment Configuration Template
# Copy this file to '.env' for local custom overrides (do not commit .env to git)

# Backend FastAPI Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_LOG_LEVEL=info

# Frontend Vite Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://127.0.0.1:8000

# Note: The core analytics pipeline runs 100% locally and offline.
# No third-party API keys (OpenAI, Gemini, Claude, AWS, etc.) are required.
